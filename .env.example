# Postgres. Keep both targets defined and copy one into DATABASE_URL — that is
# the only one the app and `npm run db:migrate` read. See "Which database am I
# talking to?" in CLAUDE.md before running anything destructive.
DATABASE_URL_DOCKER="postgres://root:mysecretpassword@localhost:5432/local"
DATABASE_URL_NEON=""
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Storage backend for missed-hour reports: "postgres" (default) | "memory".
# "memory" keeps everything in-process — no database needed, wiped on restart.
# Run "npm run db:start" and "npm run db:push" before first start
MISSED_HOUR_REPO="postgres"  # postgres | duckdb | memory

# DuckDB backend (MISSED_HOUR_REPO="duckdb"). A filesystem path runs DuckDB
# in-process; an "md:" URL runs the same SQL against MotherDuck.
#   DUCKDB_PATH="./data/vitemonprof.duckdb"
#   DUCKDB_PATH="md:vitemonprof?motherduck_token=<token>"
DUCKDB_PATH="./data/vitemonprof.duckdb"

# NOTE: the app never migrates this database, whichever of the two it is. Run
# `npm run db:migrate:duckdb` yourself before starting against a fresh file, and
# before deploying code that needs a new column. See "Nothing migrates itself" in
# CLAUDE.md.

# data.gouv.fr — the nightly publication (`npm run db:publish`, and the
# `publish-datagouv.yml` workflow, which reads these from repository secrets).
# The key is under https://www.data.gouv.fr/admin/me/ → "Clé d'API"; the account
# needs edit rights on the dataset.
DATAGOUV_API_KEY=""

# Optional, for rehearsing against the sandbox rather than production. The
# dataset defaults to the UUID of `vitemonprof-soumissions`.
#   DATAGOUV_DATASET="6a9dd54a4dc8c86f2309aad8"
#   DATAGOUV_API_URL="https://demo.data.gouv.fr/api/1"
