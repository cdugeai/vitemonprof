{
  "name": "vitemonprof",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "data:schools": "node scripts/fetch-schools.ts",
    "predev": "npm run data:schools",
    "dev": "vite dev",
    "prebuild": "npm run data:schools",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "db:start": "docker compose up",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env scripts/migrate.ts",
    "db:migrate:down": "node --env-file=.env scripts/migrate.ts down",
    "db:migrate:status": "node --env-file=.env scripts/migrate.ts status",
    "db:types": "node --env-file=.env scripts/gen-types.ts",
    "db:backfill:departement": "node --env-file=.env scripts/backfill-departement.ts",
    "db:diff": "node --env-file=.env scripts/db-diff.ts",
    "db:export:hours": "node --env-file=.env scripts/export-missed-hour.ts",
    "db:export:events": "node --env-file=.env scripts/export-missed-hour-events.ts",
    "db:migrate:duckdb": "node --env-file-if-exists=.env scripts/migrate.ts --duckdb"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.28.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/pako": "^2.0.4",
    "@types/pg": "^8.23.1",
    "auth": "^1.6.23",
    "better-auth": "^1.6.23",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "csv-writer": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-maplibre-gl": "^2.2.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@vercel/analytics": "^2.0.1",
    "kysely": "^0.29.5",
    "kysely-postgres-js": "^3.0.0",
    "lru-cache": "^11.5.2",
    "pako": "^3.0.1"
  }
}
